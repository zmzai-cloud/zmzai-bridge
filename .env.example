# zmzai-bridge 配置示例
# 复制为 .env 后修改。

# 服务监听端口（同时承载 WebSocket /bridge 与 HTTP /v1/*）
PORT=8787

# WebSocket 端点路径（客户端 BRIDGE_URL=ws://host:PORT/bridge）
BRIDGE_PATH=/bridge

# 内部 API 鉴权：relay / sandbox 调用 dispatch API 时携带的 Bearer Token
INTERNAL_API_TOKEN=dev-internal-token-change-me

# 允许不安全本地调用（跳过 Bearer 校验，仅用于本机联调，生产务必 false）
ALLOW_INSECURE_LOCAL=false

# 客户端密钥存储：JSON 映射 { "clientId": "clientSecret" }
# 生产应改为从密钥管理服务 / 数据库读取（见 src/bridge/secrets.ts 的接口）。
CLIENT_SECRETS={"demo-client":"demo-secret"}

# hello 握手签名允许的最大时间偏移（毫秒），防重放
HELLO_MAX_AGE_MS=300000

# dispatch（agent -> 客户端 -> 结果）的最长等待时间（毫秒），超时返回 504
DISPATCH_TIMEOUT_MS=120000
