{
  "name": "zmzai-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "zmzai cloud bridge — the server side of the client↔cloud bridge. Terminates the desktop client's reverse-tunnel WebSocket, routes agent tool_requests to the right client/session, and relays results back.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "client-sim": "node scripts/client-simulator.mjs",
    "agent-sim": "node scripts/agent-simulator.mjs",
    "e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
